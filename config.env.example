# VibeBar — настройки. Переменные окружения имеют приоритет.
: "${VIBEBAR_FILE:=$HOME/vibebar-journal.md}"          # журнал (держите вне синхронизируемых папок)
: "${VIBEBAR_OPENER:=TextEdit}"                        # чем открывать журнал и сводки
: "${VIBEBAR_DIGEST_DIR:=__ROOT__/digests}"            # куда складывать сводки за день
: "${VIBEBAR_VAULT_FILE:=}"                            # куда переносить сводки (Obsidian и т.п.); пусто — перенос выключен
: "${VIBEBAR_BUFFER:=__ROOT__/clipboard.txt}"          # транзитный блокнот
: "${VIBEBAR_BUFFER_MAX:=15}"                          # сколько записей хранить
: "${VIBEBAR_BUFFER_MAXLEN:=5000}"                     # не забирать куски длиннее, символов
: "${VIBEBAR_WATCH_INTERVAL:=1}"                       # опрос буфера обмена, сек
: "${VIBEBAR_PUSH_DELAY:=1}"                           # выдержка перед записью, сек
: "${VIBEBAR_AUTOPASTE:=1}"                            # 1 = клик вставляет в активное окно (нужен Accessibility)
: "${VIBEBAR_PASTE_DELAY:=0.8}"                        # пауза перед автовставкой, сек
: "${VIBEBAR_SKIP_TYPES:=ConcealedType}"               # метки pasteboard, которые пропускаем
: "${VIBEBAR_CLEAN_TERMINAL:=1}"                       # срезать приглашение терминала
: "${VIBEBAR_WRAP_CODE:=1}"                            # оборачивать вывод в ``` при вставке в чат
: "${VIBEBAR_DICTATION_WINDOW:=180}"                   # окно сверки диктовок, сек
: "${VIBEBAR_MODE_NAME:=Journal}"                       # имя режима superwhisper для журнала (должно совпадать точно)
: "${VIBEBAR_SW_MODES_DIR:=$HOME/Documents/superwhisper/modes}"  # где искать режимы superwhisper
# Шаблон приглашения терминала — подставьте своё, если оно отличается
: "${VIBEBAR_PROMPT_RE:=^\s*(?:🍏\s*)?[A-Za-z0-9._-]*-?[Mm]ac[A-Za-z0-9._-]*:\S*\s+[A-Za-z0-9._-]+\$\s?}"
